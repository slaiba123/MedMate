# ========================================
# 🌐 Universal settings (for full-stack apps)
# ========================================

# Node dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
dist/
build/
.next/
out/
.vercel/
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Yarn / pnpm cache
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ========================================
# 🖥️ FRONTEND (Next.js)
# ========================================
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/.turbo/

# ========================================
# ⚙️ BACKEND (Express / Node.js)
# ========================================
backend/dist/
backend/build/
backend/.env
backend/.DS_Store
backend/debug.log

# ========================================
# 🚀 Misc
# ========================================
*.pem
*.key
*.crt
*.zip
*.tar
